# Private key of the deployer (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Payment token address (ERC-20 token used for payments)
# Required for deployment, ignored for upgrades
PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Set to "true" to upgrade existing contract, "false" or leave empty to deploy new
UPGRADE=false

# Proxy address of existing contract (required when UPGRADE=true)
PROXY_ADDRESS=

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=

# Network RPC URL (optional, can specify via script parameter)
RPC_URL=

